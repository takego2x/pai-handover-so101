# L8b: ROS 2 Jazzy（Ubuntu 24.04, Python 3.12）に Genesis を入れた環境。Apple シリコン（arm64）用の公式イメージ。
FROM ros:jazzy-ros-base@sha256:066420e07f60aa18262f2479981def87ebcfcec42eefb0c0c57c4a46098348ca

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3-pip python3-venv libgl1 libegl1 libosmesa6 libglib2.0-0 libx11-6 libxrender1 libxext6 git \
    && rm -rf /var/lib/apt/lists/*

# rclpy（ROS 2 の Python ライブラリ）は apt の Python に入っているので、
# 仮想環境は --system-site-packages で作り、その上に Genesis などを入れる
RUN python3 -m venv --system-site-packages /opt/venv
ENV PATH=/opt/venv/bin:$PATH \
    PYOPENGL_PLATFORM=osmesa \
    PYTHONUNBUFFERED=1
RUN pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu torch==2.14.1
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
WORKDIR /work
# ROS 2 のコマンド（ros2 ...）を使えるようにする
ENTRYPOINT ["/bin/bash", "-c", "source /opt/ros/jazzy/setup.bash && exec \"$@\"", "--"]
